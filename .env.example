# 环境变量模板
#
# 使用方法：把本文件复制为 .env，然后填入你自己的真实信息。
#     PowerShell:  Copy-Item .env.example .env
#     macOS/Linux: cp .env.example .env
#
# .env 已在 .gitignore 中忽略，不会被提交到公开仓库；
# 请勿把填好真实账号密码后的 .env 发给任何人或提交到 Git。
#
# 线上不要上传本文件，改为在仓库的
# Settings → Secrets and variables → Actions 中配置下面同名变量（见 README 第四节）。

# 正方教务系统首页地址（只填到域名，不要带具体页面路径）
ZF_BASE_URL=https://jw.example.edu.cn

# 学号 / 密码
ZF_USERNAME=你的学号
ZF_PASSWORD=你的密码

# 学年与学期（学期只能是 1 或 2）
ZF_YEAR=2026
ZF_TERM=1

# 本学期第一周的周一日期（YYYY-MM-DD），用于算出当前是第几教学周，
# 从而只显示本周实际开课的课程。换学期时记得改。
SEMESTER_START_DATE=2026-08-31

# 以下为可选项，不填则用默认值

# 内存缓存有效期（秒），默认 1800
# CACHE_TTL_SECONDS=1800

# 调用正方接口的超时时间（秒），默认 8
# ZF_REQUEST_TIMEOUT=8

# 允许跨域的前端来源，默认 *（前端部署到 GitHub Pages 后建议改成具体地址）
# ALLOWED_ORIGIN=https://your-name.github.io